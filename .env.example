# Copy to `.env` at your project root. tamash-selenium reads OS env vars first, then this file.
# (Also readable as a [tool.tamash-selenium] table in pyproject.toml.)

# Master switch — any value other than false / 0 leaves healing on.
HEALER_ENABLED=true

# tamash (default, no key) | ollama | ollama-local | openai | anthropic | gemini
#   | claude-subscription | copilot-subscription
HEALER_PROVIDER=tamash

# heal (default) | warn (heal + end-of-run summary) | strict (fail inside assertions)
# HEALER_ASSERTIONS=heal

# Opt-in scroll / force / wait / dispatch recovery when an element is found but the action is blocked.
# HEALER_ACTION_RECOVERY_ENABLED=false

# Race the scoped + full-snapshot provider calls concurrently (network only).
# HEALER_PARALLEL=false

# ---- provider credentials (fill in only the one you chose) ----

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# OLLAMA_API_KEY=            # free from ollama.com/settings/keys
# OLLAMA_MODEL=gpt-oss:120b

# OLLAMA_LOCAL_MODEL=llama3.1
# OLLAMA_LOCAL_BASE_URL=http://localhost:11434

# CLAUDE_CODE_OAUTH_TOKEN=   # from `claude setup-token`
# CLAUDE_SUBSCRIPTION_MODEL=claude-haiku-4-5

# COPILOT_SUBSCRIPTION_MODEL=mai-code-1-flash-picker

# ---- integration lifecycle (pytest fixture / Behave / unittest base class) ----

# TAMASH_BROWSER=chrome      # chrome | firefox | edge | safari
# HEADLESS=true
# TAMASH_REUSE_DRIVER=false
# TAMASH_KEEP_IMPLICIT_WAIT=false

# ---- report / diagnostics ----

# TAMASH_REPORT=report.html
# TAMASH_ACTION_TIMEOUT_MS=20000
# TAMASH_DEBUG=1
